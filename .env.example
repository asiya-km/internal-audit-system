# =============================================================================
# Internal Audit Management System — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# =============================================================================

# ---- Global ----
NODE_ENV=development

# ---- API / Backend ----
PORT=4000
DATABASE_URL=postgresql://iams:iams@localhost:5432/iams?schema=public
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ---- Frontend ----
VITE_API_URL=http://localhost:4000/api

# ---- Docker Postgres ----
POSTGRES_USER=iams
POSTGRES_PASSWORD=iams
POSTGRES_DB=iams
POSTGRES_PORT=5432
